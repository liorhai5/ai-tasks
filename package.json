{
  "name": "ai-tasks",
  "version": "0.1.0",
  "description": "Personal, machine-local task coordination service for AI coding assistants",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liorhai5/ai-tasks.git"
  },
  "homepage": "https://github.com/liorhai5/ai-tasks#readme",
  "bugs": {
    "url": "https://github.com/liorhai5/ai-tasks/issues"
  },
  "author": "Lior Hai",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai-tasks": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^11.10.0",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
